# EXTRACT_MODE controls which extraction service is used.
# Options: mock | real (default: mock)
# - mock: uses the MockExtractionService with fixture JSON and simulated SSE events
# - real: uses the RealExtractionService (Phase 2 — requires API keys below)
EXTRACT_MODE=mock

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Required for rate limiting, videoId cache, and global daily spend cap (COST-01/02/03).
# Note: Vercel's built-in KV product uses KV_REST_API_URL / KV_REST_API_TOKEN naming.
#       Both naming conventions work — the Redis client reads either set automatically.
UPSTASH_REDIS_REST_URL=     # Upstash Console → Database → REST API → UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=   # Upstash Console → Database → REST API → UPSTASH_REDIS_REST_TOKEN
# Vercel KV aliases (auto-injected by Vercel when you link a KV store — same Redis):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Google Gemini 2.5 Flash — used by the real extraction pipeline (Plan 02-03+).
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=   # https://aistudio.google.com/app/apikey

# ─── Spend cap ────────────────────────────────────────────────────────────────
# D-20c: global daily extraction cap (~250 extractions ≈ $5/day at $0.02/extraction).
# Tunable without redeploy — bump this value in Vercel env vars to increase the cap.
DAILY_EXTRACTION_CAP=250        # D-20c: $5/day cap at ~$0.02/extraction; tunable without redeploy

# ─── Smoke test alerts (Plan 02-07 — OPS-05) ─────────────────────────────────
RESEND_API_KEY=     # https://resend.com/api-keys (smoke-test alert emails)
ALERT_EMAIL=        # e.g. hello@exercised.app — smoke alert recipient

# ─── Vercel Cron auth ─────────────────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer $CRON_SECRET" on cron-triggered requests.
# Generate with: openssl rand -base64 32
CRON_SECRET=        # Random secret — generate with: openssl rand -base64 32

# ─── GitHub Issue creation for smoke failures ─────────────────────────────────
GITHUB_TOKEN=       # GitHub PAT with repo scope (used by smoke test to open failure issues)
GITHUB_REPO=        # e.g. username/exercised
